

datasource db {
  provider  = "mysql"
  url  	    = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "windows"]
}


model Product {
  id            String   @id @default(cuid())
  name          String                
  ingredients   String?               
  allergens     String?               
  size          String?
  price         String?
  EAN           String?                
  photoUrl      String?        
  producer      String?
  producedIn    String?
  ECodes        String?
  preservation  String?
  energia       String?
  rasva         String?
  hiilarit      String?
  sokerit_yht   String?
  sokerit_lis   String?
  proteiini     String?
  suola         String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt



  @@index([name])
}